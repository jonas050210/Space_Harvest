# AI Vision Lab — git ignore
# The VISION MODELS (data/models, ~30 MB) ARE part of the repository so a
# fresh clone works fully offline. USER data (images, settings, snapshots,
# face photos, acceptance reports) and all runtime artifacts stay out.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environment
.venv/
venv/
env/

# User data (models are the only bundled part of data/)
data/generated/
data/uploads/
data/snapshots/
data/settings.json
data/calibration.json
data/face_reference/
data/recordings/
data/extensions/
logs/*.log

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Hardware acceptance reports (generated on the target machine)
smoke*.json
acceptance*.json
stability*.json
hardware*.json

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# PyInstaller output
AI-Vision-Lab/
